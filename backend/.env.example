# ---------------------------------------------------------------------------
# PayFlow backend environment
# Copy to .env and fill in real values. NEVER commit .env files.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
CORS_ORIGINS=*

# PostgreSQL (integer minor units, double-entry ledger)
DATABASE_URL=postgresql://payflow:payflow@localhost:5432/payflow?schema=public

# Secrets — generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Password / PIN hashing cost
BCRYPT_ROUNDS=12

# Demo mode: simulated funding, OTP echo in API responses, mock bank lookups.
# Set to false for any environment that looks like production.
DEMO_MODE=true

# ---------------------------------------------------------------------------
# Paystack — TEST MODE ONLY. Keys must never be exposed to the mobile app.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret (defaults to the secret key, which is what Paystack signs with)
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENT_PROVIDER=paystack

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCK_MINUTES=15

# Money limits (minor units = kobo)
MIN_FUNDING_MINOR=10000
MAX_FUNDING_MINOR=100000000
MIN_TRANSFER_MINOR=1000
MAX_TRANSFER_MINOR=50000000
MIN_WITHDRAWAL_MINOR=10000
MAX_WITHDRAWAL_MINOR=50000000
MAX_WALLET_BALANCE_MINOR=500000000
DAILY_OUTFLOW_LIMIT_MINOR=100000000

LOG_LEVEL=info
